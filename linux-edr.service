[Unit]
Description=Linux Endpoint Detection and Response
After=network.target

[Service]
Type=simple
User=root
ExecStartPre=/bin/sh -c 'echo 1 > /sys/kernel/tracing/events/syscalls/sys_enter_execve/enable'
ExecStart=/usr/local/bin/linux-edr --output-file /var/log/linux-edr/reports.jsonl
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# Security hardening
ProtectSystem=full
ReadWritePaths=/var/log/linux-edr
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target 